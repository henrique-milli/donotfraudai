<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/at_paper"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/at_ink" />

        <ch.attest.onboarding.ui.widget.StepBar
            android:id="@+id/stepBar"
            android:layout_width="112dp"
            android:layout_height="20dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/at_gutter"
            android:paddingEnd="@dimen/at_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/at_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 3 of 4" />

                <TextView
                    android:id="@+id/required"
                    style="@style/at_label"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/at_ink"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Required"
                    android:textColor="@color/at_on_ink"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/at_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nfc_title" />

            <TextView
                android:id="@+id/body"
                style="@style/at_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/nfc_body" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card">

                <ch.attest.onboarding.ui.widget.NfcPulseView
                    android:id="@+id/pulse"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_gravity="center" />

                <ch.attest.onboarding.ui.widget.ArcSpinner
                    android:id="@+id/progress"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- presenter: what the chip step proves -->
            <LinearLayout
                android:id="@+id/stageBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_outline"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/stageTitle"
                    style="@style/at_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presenter · chip"
                    android:textColor="@color/at_signal" />

                <TextView
                    android:id="@+id/docLine"
                    style="@style/at_mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/at_ink" />

                <TextView
                    style="@style/at_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Derived from the printed MRZ (document no. · birth · expiry). PACE / BAC opens the chip, then Passive Authentication checks the issuer's signature over the data. A printed card cannot fake this." />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/at_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/at_gutter"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnSettings"
            style="@style/at_button_primary"
            android:layout_marginBottom="8dp"
            android:text="@string/nfc_settings"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSkip"
            style="@style/at_button_text"
            android:layout_width="match_parent"
            android:text="@string/nfc_skip" />
    </LinearLayout>
</LinearLayout>
