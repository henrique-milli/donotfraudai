<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/at_paper"
    android:orientation="vertical"
    android:paddingStart="@dimen/at_gutter"
    android:paddingEnd="@dimen/at_gutter"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/mark"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_step_index"
            android:contentDescription="@null"
            android:padding="24dp"
            android:src="@drawable/ic_check" />

        <TextView
            style="@style/at_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/done_title" />

        <TextView
            style="@style/at_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/done_body" />
    </LinearLayout>

    <TextView
        android:id="@+id/presenterNote"
        style="@style/at_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:text="Presenter note: this is all the applicant sees, whatever the verdict. No reason is given, so an attacker learns nothing to iterate on."
        android:visibility="gone" />

    <Button
        android:id="@+id/btnDone"
        style="@style/at_button_primary"
        android:text="@string/done_again" />
</LinearLayout>
