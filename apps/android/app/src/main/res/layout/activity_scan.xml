<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/at_night">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ch.attest.onboarding.ui.widget.CardFrameView
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/windowCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.40" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/belowWindow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.575" />

    <!-- top bar -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle_glass"
        android:contentDescription="Back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <ch.attest.onboarding.ui.widget.StepBar
        android:id="@+id/stepBar"
        android:layout_width="112dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <ImageButton
        android:id="@+id/btnFlash"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_glass"
        android:contentDescription="Flash"
        android:src="@drawable/ic_flash_off"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <ImageButton
        android:id="@+id/btnMode"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_circle_glass"
        android:contentDescription="Verbose view"
        android:src="@drawable/ic_eye"
        app:layout_constraintEnd_toStartOf="@id/btnFlash"
        app:layout_constraintTop_toTopOf="@id/btnFlash" />

    <TextView
        android:id="@+id/stepLabel"
        style="@style/at_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="@color/at_on_night_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        tools:text="Step 1 of 3" />

    <TextView
        android:id="@+id/title"
        style="@style/at_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepLabel"
        tools:text="Front of your card" />

    <!-- verbose: which quality gate is holding the capture, in plain words -->
    <TextView
        android:id="@+id/gateBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#FFC24B"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="16dp"
        android:paddingTop="7dp"
        android:paddingEnd="16dp"
        android:paddingBottom="7dp"
        android:textColor="#111112"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Glare on the card · ROI 3.1%"
        tools:visibility="visible" />

    <!-- guidance, under the window -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/belowWindow"
        tools:text="Place the side with your photo inside the frame" />

    <!-- capture state, centred on the window -->
    <ch.attest.onboarding.ui.widget.ArcSpinner
        android:id="@+id/spinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/windowCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/windowCenter" />

    <ImageView
        android:id="@+id/doneMark"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#2BD48A"
        android:contentDescription="@null"
        android:padding="16dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/windowCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/windowCenter" />

    <!-- presenter HUD: what the models see, live -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/hudDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/at_signal" />

            <TextView
                android:id="@+id/hudTitle"
                style="@style/at_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Live signals"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/hudMeta"
                style="@style/at_mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/at_on_night_3"
                android:textSize="11sp"
                tools:text="gyro 0.021 · 14 fps" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hudChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/hudReadout"
            style="@style/at_mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/at_on_night_2"
            tools:text="Glare · ROI 3.1% · full 0.4%" />
    </LinearLayout>
    <!-- verbose: presentation-attack results after each capture, large enough for an audience -->
    <LinearLayout
        android:id="@+id/padPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_hud"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/padTitle"
            style="@style/at_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:text="Presentation-attack checks · front" />

        <LinearLayout
            android:id="@+id/padRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/padVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="invisible"
            tools:text="No attack detected" />

        <TextView
            android:id="@+id/padFoot"
            style="@style/at_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Scored and sealed to the backend · the applicant never sees this · tap to continue"
            android:textColor="@color/at_on_night_3"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- card flip, before scanning the back (both modes: it is guidance, not a signal) -->
    <LinearLayout
        android:id="@+id/flipOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F00B0B0C"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ch.attest.onboarding.ui.widget.CardFlipView
            android:id="@+id/flipCard"
            android:layout_width="match_parent"
            android:layout_height="320dp" />

        <TextView
            style="@style/at_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/flip_title"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:gravity="center"
            android:text="@string/flip_body"
            android:textColor="@color/at_on_night_2"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
