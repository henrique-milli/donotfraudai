<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/at_paper"
    android:orientation="vertical">

    <!-- brand bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/at_gutter"
        android:paddingEnd="@dimen/at_gutter">

        <LinearLayout
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/at_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textSize="19sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- verbose / production switch (presenter builds only) -->
        <LinearLayout
            android:id="@+id/modeToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/modeVerbose"
                style="@style/at_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Verbose" />

            <TextView
                android:id="@+id/modeProd"
                style="@style/at_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Production" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/at_gutter"
            android:paddingTop="20dp"
            android:paddingEnd="@dimen/at_gutter"
            android:paddingBottom="24dp">

            <TextView
                style="@style/at_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_kicker"
                android:textColor="@color/at_signal" />

            <TextView
                style="@style/at_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_title" />

            <TextView
                style="@style/at_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/home_body" />

            <LinearLayout
                android:id="@+id/stageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/at_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_stage_title"
                    android:textColor="@color/at_ink" />

                <TextView
                    style="@style/at_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_stage_body" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pendingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_option"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/at_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pending_title" />

                <TextView
                    style="@style/at_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/pending_body" />

                <Button
                    android:id="@+id/btnPending"
                    style="@style/at_button_primary"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/pending_start" />
            </LinearLayout>

            <TextView
                style="@style/at_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/home_choose" />

            <LinearLayout
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                style="@style/at_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/home_steps" />

            <LinearLayout
                android:id="@+id/steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </ScrollView>

    <!-- action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/at_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/at_gutter"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/loadingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ch.attest.onboarding.ui.widget.ArcSpinner
                android:id="@+id/loadingSpinner"
                android:layout_width="16dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/loadingText"
                style="@style/at_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/home_loading" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            style="@style/at_button_primary"
            android:enabled="false"
            android:text="@string/home_continue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock" />

            <TextView
                style="@style/at_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/home_private"
                android:textColor="@color/at_ink_3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
