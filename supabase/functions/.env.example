# Copy to supabase/functions/.env (or run `pnpm lan`, which creates it with fresh values).
# ATTEST_KEYS: {"<kid>": "<PKCS#8 base64 of a P-256 key>"} — `deno task keygen` in functions/attest
ATTEST_KEYS={"k1":"<pkcs8-base64>"}
ATTEST_ACTIVE_KID=k1
# shared analyst token for the triage console (≥ 16 characters)
ANALYST_TOKEN=<random>
# face service (services/face); host.docker.internal reaches the laptop from the edge runtime
FACE_SERVICE_URL=http://host.docker.internal:8003
FACE_SERVICE_TOKEN=
# face-swap / deepfake check (services/faceswap — mock today; same contract for a real model)
FACESWAP_SERVICE_URL=http://host.docker.internal:8004
FACESWAP_SERVICE_TOKEN=
# only outside Supabase (plain Postgres + pgvector, see docker-compose `standalone` profile)
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54399/postgres
# ATTEST_IMAGES_IN_DB=1
